---
const { title = "Cloud Project" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{title}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style is:global>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background: radial-gradient(circle at top, #0a0a0a, #000);
      color: #fff;
      overflow-x: hidden;
      min-height: 100vh;
    }

    header {
      position: fixed;
      width: 100%;
      padding: 20px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(0,0,0,0.6);
      backdrop-filter: blur(12px);
      z-index: 100;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    header h1 {
      font-size: 20px;
      background: linear-gradient(to right, #fff, #888);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    header nav a {
      margin-left: 20px;
      color: #aaa;
      text-decoration: none;
      font-size: 14px;
      transition: 0.3s;
    }

    header nav a:hover {
      color: #fff;
    }

    section {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 100px 20px;
    }

    .hero {
      flex-direction: column;
    }

    .hero h2 {
      font-size: clamp(32px, 8vw, 64px);
      margin-bottom: 20px;
    }

    .hero p {
      color: #aaa;
      font-size: clamp(16px, 4vw, 20px);
      max-width: 600px;
    }

    .btn {
      margin-top: 30px;
      padding: 14px 32px;
      border-radius: 30px;
      background: #fff;
      color: #000;
      border: none;
      font-weight: 600;
      cursor: pointer;
      transition: 0.3s;
    }

    .btn:hover {
      transform: scale(1.05);
      box-shadow: 0 0 20px rgba(255,255,255,0.4);
    }

    .glow {
      position: fixed;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(0,150,255,0.15), transparent);
      filter: blur(100px);
      top: 10%;
      left: 20%;
      z-index: -1;
      pointer-events: none;
    }

    .feature {
      flex-direction: column;
    }

    .feature h3 {
      font-size: 42px;
      margin-bottom: 20px;
    }

    .card {
      margin-top: 30px;
      padding: 30px;
      border-radius: 20px;
      background: rgba(255,255,255,0.03);
      backdrop-filter: blur(15px);
      border: 1px solid rgba(255,255,255,0.1);
      width: 100%;
      max-width: 500px;
    }

    .metrics {
      display: flex;
      gap: 40px;
      margin-top: 50px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .metric h4 {
      font-size: 40px;
      font-variant-numeric: tabular-nums;
    }

    .metric p {
      color: #666;
      text-transform: uppercase;
      font-size: 12px;
      letter-spacing: 1px;
    }

    /* Animaciones */
    .fade-in {
      opacity: 0;
      transform: translateY(30px);
      transition: all 0.8s ease-out;
    }

    .visible {
      opacity: 1;
      transform: translateY(0);
    }

    footer {
      text-align: center;
      padding: 60px 40px;
      color: #444;
      border-top: 1px solid rgba(255,255,255,0.05);
    }
  </style>
</head>

<body>
  <div class="glow"></div>

  <header>
    <h1>Cloud Project</h1>
    <nav>
      <a href="/">Inicio</a>
      <a href="#features">Features</a>
      <a href="https://aws.amazon.com" target="_blank">AWS</a>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <p>© 2026 AWS Cloud Project 🚀 — Built with Astro</p>
  </footer>

</body>
</html>